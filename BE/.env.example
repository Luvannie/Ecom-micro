# ===========================================
# Ecom Micro Services - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# ===========================================
# Database Passwords (Required)
# ===========================================
POSTGRES_PASSWORD=your_secure_postgres_password
AUTH_DB_PASSWORD=your_secure_auth_db_password
USER_DB_PASSWORD=your_secure_user_db_password
PRODUCT_DB_PASSWORD=your_secure_product_db_password
INVENTORY_DB_PASSWORD=your_secure_inventory_db_password
ORDER_DB_PASSWORD=your_secure_order_db_password
PAYMENT_DB_PASSWORD=your_secure_payment_db_password
NOTIFICATION_DB_PASSWORD=your_secure_notification_db_password

# ===========================================
# Redis (Required)
# ===========================================
REDIS_PASSWORD=your_secure_redis_password

# ===========================================
# JWT (Required)
# ===========================================
# Must be at least 32 characters for HS256
JWT_SECRET=your-very-long-and-secure-jwt-secret-key-min-32-chars

# ===========================================
# Grafana (Required)
# ===========================================
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password

# ===========================================
# Keycloak (Required)
# ===========================================
# Admin console credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_secure_keycloak_admin_password

# Keycloak database
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=your_secure_keycloak_db_password
KEYCLOAK_DB_PORT=5440

# Keycloak server
KEYCLOAK_PORT=8081

# OIDC endpoints (used by gateway and services)
KEYCLOAK_ISSUER=http://localhost:8081/realms/ecom
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/ecom/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URI=http://localhost:8081/realms/ecom/protocol/openid-connect/token
KEYCLOAK_LOGIN_URI=http://localhost:8081/realms/ecom/protocol/openid-connect/auth

# Confidential client for service-to-service auth (auth-service → Keycloak Admin API)
KEYCLOAK_BACKEND_CLIENT_SECRET=your_secure_backend_client_secret

# ===========================================
# Kafka (Optional - defaults shown)
# ===========================================
KAFKA_REPLICATION_FACTOR=1

# ===========================================
# Port Overrides (Optional)
# ===========================================
# Uncomment to override default ports
# POSTGRES_PORT=5432
# AUTH_DB_PORT=5433
# USER_DB_PORT=5434
# PRODUCT_DB_PORT=5435
# INVENTORY_DB_PORT=5436
# ORDER_DB_PORT=5437
# PAYMENT_DB_PORT=5438
# NOTIFICATION_DB_PORT=5439
# REDIS_PORT=6379
# KAFKA_PORT=9092
# ZIPKIN_PORT=9411
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001

# ===========================================
# Database Names (Optional)
# ===========================================
# POSTGRES_DB=ecom
# AUTH_DB_NAME=auth_service
# USER_DB_NAME=user_service
# PRODUCT_DB_NAME=product_service
# INVENTORY_DB_NAME=inventory_service
# ORDER_DB_NAME=order_service
# PAYMENT_DB_NAME=payment_service
# NOTIFICATION_DB_NAME=notification_service

# ===========================================
# Database Users (Optional - rarely needed)
# ===========================================
# POSTGRES_USER=ecom
# AUTH_DB_USER=auth_user
# USER_DB_USER=user_user
# PRODUCT_DB_USER=product_user
# INVENTORY_DB_USER=inventory_user
# ORDER_DB_USER=order_user
# PAYMENT_DB_USER=payment_user
# NOTIFICATION_DB_USER=notification_user