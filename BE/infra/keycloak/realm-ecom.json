    {
      "name": "roles",
      "description": "OpenID Connect scope for add user realm roles to the access token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${rolesConsentText}"
